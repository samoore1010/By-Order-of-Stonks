# Do not commit populated credentials. Local development only:
APP_ENV=development
# Public/Railway deployments MUST use APP_ENV=production and unique values below.
APP_PASSWORD=
SESSION_SECRET=
# Optional exact HTTPS application origin for CSRF checks.
PUBLIC_ORIGIN=
# Railway volume: mount /app/data. Alternatively, supply a PostgreSQL URL.
DATABASE_URL=sqlite:///data/stonks.db
KALSHI_ENV=production
# Optional read-only Kalshi credentials. No order submission exists in this release.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=
# Optional AI copilot. A ChatGPT subscription does not populate these credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_CALLS_PER_DAY=40
NWS_USER_AGENT=ByOrderOfStonks-research/0.2 contact@example.com
# Optional private GitHub intake; read access only.
GITHUB_READ_TOKEN=

# Optional LLM-backed Director and independent qualitative reviewer. Shares daily budget.
AGENT_LLM_ENABLED=false
DIRECTOR_MODEL=
VALIDATOR_MODEL=
